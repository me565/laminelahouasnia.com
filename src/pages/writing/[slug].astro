---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, url } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 230));
---

<Base title={post.data.title} description={post.data.description} current="writing" type="article">
  <article class="wrap page">
    <header class="head">
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span>{minutes} min read</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="standfirst">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {post.data.originalUrl && (
      <p class="origin">
        First published on <a href={post.data.originalUrl}>LinkedIn</a>, where you can also see the original images and
        join the discussion.
      </p>
    )}

    <nav class="pager" aria-label="More writing">
      {older ? (
        <a href={url(`/writing/${older.id}/`)} rel="prev">
          <span>Older</span>
          {older.data.title}
        </a>
      ) : <span />}
      {newer && (
        <a class="newer" href={url(`/writing/${newer.id}/`)} rel="next">
          <span>Newer</span>
          {newer.data.title}
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .page { padding-top: clamp(2rem, 6vw, 4rem); }
  .head { max-width: 46rem; margin-bottom: 2.5rem; }
  .meta {
    display: flex;
    gap: 1.25rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--ink-faint);
    margin-bottom: 1rem;
  }
  h1 { font-size: clamp(2.1rem, 5.5vw, 3.6rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.02; }
  .standfirst { font-size: 1.3rem; line-height: 1.5; color: var(--ink-soft); margin-top: 1.25rem; max-width: var(--measure); }
  .origin {
    max-width: var(--measure);
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .pager {
    max-width: var(--measure);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    font-family: var(--sans);
  }
  .pager a { color: var(--ink); text-decoration: none; font-weight: 600; line-height: 1.3; }
  .pager a:hover { color: var(--blue); text-decoration: underline; }
  .pager span { display: block; font-weight: 400; font-size: 0.85rem; color: var(--ink-faint); margin-bottom: 0.25rem; }
  .newer { text-align: right; }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .newer { text-align: left; }
  }
</style>
