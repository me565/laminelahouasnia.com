---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, url } from '../../lib/site';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
---

<Base title="Writing" description="Articles by Lamine Lahouasnia on Gen AI, agents and trust in market research." current="writing">
  <div class="wrap page">
    <h1>Writing</h1>
    <p class="lede">
      Essays on Gen AI in market research: where it goes wrong, what it costs, and how to build it so people can trust
      the answer. Most first appeared on LinkedIn.
    </p>

    {years.map((year) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        <ol>
          {posts
            .filter((p) => p.data.pubDate.getUTCFullYear() === year)
            .map((post) => (
              <li>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <div>
                  <a href={url(`/writing/${post.id}/`)}>{post.data.title}</a>
                  <p>{post.data.description}</p>
                </div>
              </li>
            ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .page { padding-top: clamp(2rem, 6vw, 4rem); }
  h1 { font-size: clamp(2.6rem, 7vw, 4.5rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 1rem; }
  .lede { max-width: var(--measure); color: var(--ink-soft); font-size: 1.2rem; }
  .year { margin-top: 3rem; display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem 2rem; }
  .year h2 { font-size: 1.1rem; color: var(--ink-faint); font-weight: 600; padding-top: 1.3rem; }
  ol { list-style: none; margin: 0; padding: 0; max-width: 48rem; }
  li {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  time { font-family: var(--sans); font-size: 0.92rem; color: var(--ink-faint); padding-top: 0.2rem; }
  li a {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
  }
  li a:hover { color: var(--blue); text-decoration: underline; }
  li p { margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 1.05rem; }

  @media (max-width: 760px) {
    .year { grid-template-columns: 1fr; gap: 0; }
    .year h2 { padding-top: 0; margin-bottom: 0.5rem; }
    li { grid-template-columns: 1fr; }
  }
</style>
