---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Page not found">
  <div class="wrap page">
    <h1>This page doesn’t exist</h1>
    <p>The link may be old or mistyped. Try the <a href={url('/writing/')}>list of articles</a> or go to the <a href={url('/')}>home page</a>.</p>
  </div>
</Base>

<style>
  .page { padding-top: clamp(3rem, 8vw, 6rem); max-width: 40rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 1rem; }
</style>
