---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.jpg';
import { LEXICON, formatDate, getPosts, url } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 4);
const titles = Object.fromEntries(posts.map((p) => [p.id, p.data.title]));
---

<Base current="home">
  <section class="hero" aria-labelledby="hero-name">
    <div class="wrap hero-grid">
      <div class="photo">
        <Image src={portrait} alt="Black-and-white portrait of Lamine Lahouasnia" width={400} height={400} loading="eager" />
      </div>
      <div class="intro">
        <h1 id="hero-name">Lamine<br />Lahouasnia</h1>
        <p class="role">Director of Gen AI at Euromonitor International, in Singapore.</p>
        <p class="pitch">
          I build AI that market researchers and their clients can trust, and I write about the gap between an
          answer that looks right and one that is right.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="lexicon-title">
    <h2 id="lexicon-title">Ideas I’ve named</h2>
    <p class="lede">Most of my writing names a way AI goes wrong in research, or a way to fix it. Each one links to the piece that introduced it.</p>
    <dl class="lexicon">
      {LEXICON.map((item) => (
        <div class="entry">
          <dt><a href={url(`/writing/${item.slug}/`)}>{item.term}</a></dt>
          <dd>{item.meaning}<span class="source">From “{titles[item.slug]}”</span></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap block" aria-labelledby="latest-title">
    <div class="head-row">
      <h2 id="latest-title">Latest writing</h2>
      <a href={url('/writing/')}>All {posts.length} articles</a>
    </div>
    <ol class="latest">
      {latest.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <a class="t" href={url(`/writing/${post.id}/`)}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap block building" aria-labelledby="building-title">
    <h2 id="building-title">What I’m building</h2>
    <div class="building-text">
      <p>
        Outside work I’m running a small, AI-native games studio. <strong>The Moth House</strong> is an eerie
        point-and-click puzzle game in the spirit of Rusty Lake. AI agents triage feedback, build and test from a work
        board, and I review and sign off each week.
      </p>
      <p>
        It’s the most honest test I know of where AI genuinely helps, and where taste still has to come from a
        person. <a href={url('/about/#building')}>More about the studio</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--night);
    color: var(--night-ink);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: end;
    padding-block: clamp(2rem, 6vw, 4.5rem) 0;
  }
  .photo img {
    width: 100%;
    /* Feather the portrait's own dark backdrop into the band. */
    -webkit-mask-image: radial-gradient(ellipse 72% 78% at 50% 44%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 72% 78% at 50% 44%, #000 62%, transparent 100%);
  }
  .intro { padding-bottom: clamp(2rem, 5vw, 4rem); }
  h1 {
    font-size: clamp(3.2rem, 8.4vw, 6.6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
    margin-bottom: 1.5rem;
  }
  .role {
    font-family: var(--sans);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 500;
    color: var(--night-ink);
    margin-bottom: 0.75rem;
  }
  .pitch {
    max-width: 34rem;
    color: var(--night-soft);
    font-size: 1.15rem;
    margin: 0;
  }

  .block { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .block h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 0.75rem; }
  .lede { max-width: var(--measure); color: var(--ink-soft); }

  .lexicon {
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
  }
  .entry { margin: 0; }
  .lexicon dt {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }
  .lexicon dt a { text-decoration: none; }
  .lexicon dt a:hover { text-decoration: underline; }
  .lexicon dd { margin: 0; line-height: 1.55; }
  .source {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .head-row {
    max-width: 46rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--sans);
  }
  .latest {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    max-width: 46rem;
  }
  .latest li { padding-block: 1.25rem; border-top: 1px solid var(--rule); }
  .latest time {
    display: block;
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-bottom: 0.2rem;
  }
  .latest .t {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
  }
  .latest .t:hover { color: var(--blue); text-decoration: underline; }
  .latest p { margin: 0.4rem 0 0; color: var(--ink-soft); }

  .building-text { max-width: var(--measure); }

  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; align-items: start; }
    .photo { max-width: 15rem; order: -1; }
    .intro { padding-bottom: 2.5rem; }
    .lexicon { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
